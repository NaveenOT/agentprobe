AGENTPROBE_STORAGE_BACKEND=memory
AGENTPROBE_TEMPLATE_BACKEND=mongodb
AGENTPROBE_MONGODB_URI=mongodb://localhost:27017
AGENTPROBE_MONGODB_DATABASE=agentprobe
AGENTPROBE_GROQ_API_KEY=
AGENTPROBE_GROQ_MODEL=openai/gpt-oss-120b
AGENTPROBE_GROQ_TARGET_MODEL=openai/gpt-oss-20b
AGENTPROBE_DEMO_PROVIDER=auto
AGENTPROBE_DATASET_ENABLED=true
AGENTPROBE_DATASET_PATH=hackaprompt_local
AGENTPROBE_DATASET_SAMPLE_LIMIT=5000
AGENTPROBE_BROWSER_PROFILE_DIR=data/browser-profile
AGENTPROBE_AI_DOM_DETECTION=true
AGENTPROBE_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
